{
  "$schema": "https://raw.githubusercontent.com/microsoft/vscode/main/extensions/json-language-features/server/schema/tmlanguage.schema.json",
  "name": "Orus",
  "scopeName": "source.orus",
  "fileTypes": ["orus"],
  "patterns": [
    { "include": "#comments" },
    { "include": "#strings" },
    { "include": "#numbers" },
    { "include": "#booleans" },
    { "include": "#function-definition" },
    { "include": "#struct-definition" },
    { "include": "#enum-definition" },
    { "include": "#impl-block" },
    { "include": "#labels" },
    { "include": "#constants" },
    { "include": "#keywords" },
    { "include": "#builtins" },
    { "include": "#types" },
    { "include": "#variables" },
    { "include": "#function-call" },
    { "include": "#operators" }
  ],
  "repository": {
    "comments": {
      "patterns": [
        {
          "name": "comment.line.double-slash.orus",
          "match": "//.*$"
        },
        {
          "name": "comment.block.orus",
          "begin": "/\*",
          "end": "\*/",
          "patterns": [
            { "include": "#comments" }
          ]
        }
      ]
    },
    "strings": {
      "patterns": [
        {
          "name": "string.quoted.double.orus",
          "begin": "\"",
          "beginCaptures": {
            "0": { "name": "punctuation.definition.string.begin.orus" }
          },
          "end": "\"",
          "endCaptures": {
            "0": { "name": "punctuation.definition.string.end.orus" }
          },
          "patterns": [
            {
              "name": "constant.character.escape.orus",
              "match": "\\\\(?:\\\\|\"|'|n|r|t)"
            }
          ]
        }
      ]
    },
    "numbers": {
      "patterns": [
        {
          "name": "constant.numeric.orus",
          "match": "\\b(?:0b[01_]+|0o[0-7_]+|0x[0-9a-fA-F_]+|[0-9][0-9_]*(?:\\.[0-9_]+)?(?:[eE][+-]?[0-9_]+)?)(?:i32|i64|u32|u64|f64|u)?\\b"
        }
      ]
    },
    "booleans": {
      "patterns": [
        {
          "name": "constant.language.boolean.orus",
          "match": "\\b(?:true|false)\\b"
        }
      ]
    },
    "function-definition": {
      "patterns": [
        {
          "name": "meta.function.definition.orus",
          "match": "\\b(?:(pub)\\s+)?(fn)\\s+([A-Za-z_][\\w]*)",
          "captures": {
            "1": { "name": "storage.modifier.orus" },
            "2": { "name": "keyword.declaration.function.orus" },
            "3": { "name": "entity.name.function.orus" }
          }
        }
      ]
    },
    "struct-definition": {
      "patterns": [
        {
          "name": "meta.struct.definition.orus",
          "match": "\\b(?:(pub)\\s+)?(struct)\\s+([A-Za-z_][\\w]*)",
          "captures": {
            "1": { "name": "storage.modifier.orus" },
            "2": { "name": "keyword.declaration.struct.orus" },
            "3": { "name": "entity.name.type.struct.orus" }
          }
        }
      ]
    },
    "enum-definition": {
      "patterns": [
        {
          "name": "meta.enum.definition.orus",
          "match": "\\b(?:(pub)\\s+)?(enum)\\s+([A-Za-z_][\\w]*)",
          "captures": {
            "1": { "name": "storage.modifier.orus" },
            "2": { "name": "keyword.declaration.enum.orus" },
            "3": { "name": "entity.name.type.enum.orus" }
          }
        }
      ]
    },
    "impl-block": {
      "patterns": [
        {
          "name": "meta.impl.definition.orus",
          "match": "\\b(impl)\\s+([A-Za-z_][\\w]*)",
          "captures": {
            "1": { "name": "keyword.declaration.impl.orus" },
            "2": { "name": "entity.name.type.class.orus" }
          }
        }
      ]
    },
    "labels": {
      "patterns": [
        {
          "name": "entity.name.label.orus",
          "match": "'([A-Za-z_][\\w]*)\\s*:(?=\\s*(?:while|for))",
          "captures": {
            "1": { "name": "entity.name.label.orus" }
          }
        }
      ]
    },
    "constants": {
      "patterns": [
        {
          "name": "constant.other.constant.orus",
          "match": "\\b[A-Z][A-Z0-9_]*\\b"
        }
      ]
    },
    "keywords": {
      "patterns": [
        {
          "name": "storage.modifier.orus",
          "match": "\\b(?:pub|mut)\\b"
        },
        {
          "name": "keyword.declaration.function.orus",
          "match": "\\bfn\\b"
        },
        {
          "name": "keyword.declaration.type.orus",
          "match": "\\b(?:struct|enum)\\b"
        },
        {
          "name": "keyword.declaration.impl.orus",
          "match": "\\bimpl\\b"
        },
        {
          "name": "keyword.control.conditional.orus",
          "match": "\\b(?:if|elif|else|match)\\b"
        },
        {
          "name": "keyword.control.loop.orus",
          "match": "\\b(?:while|for)\\b"
        },
        {
          "name": "keyword.control.flow.orus",
          "match": "\\b(?:break|continue|return|pass)\\b"
        },
        {
          "name": "keyword.control.exception.orus",
          "match": "\\b(?:try|catch)\\b"
        },
        {
          "name": "keyword.control.import.orus",
          "match": "\\b(?:use|as)\\b"
        },
        {
          "name": "keyword.operator.logical.orus",
          "match": "\\b(?:and|or|not|matches)\\b"
        },
        {
          "name": "keyword.operator.membership.orus",
          "match": "\\bin\\b"
        }
      ]
    },
    "builtins": {
      "patterns": [
        {
          "name": "support.function.builtin.orus",
          "match": "\\b(?:print|len|push|pop|sorted|range|input|int|float|typeof|istype|timestamp)\\b(?=\\s*\\()"
        }
      ]
    },
    "types": {
      "patterns": [
        {
          "name": "support.type.numeric.orus",
          "match": "\\b(?:i32|i64|u32|u64|f64)\\b"
        },
        {
          "name": "support.type.text.orus",
          "match": "\\bstring\\b"
        }
      ]
    },
    "variables": {
      "patterns": [
        {
          "name": "variable.other.orus",
          "match": "\\b(?!(?:and|as|break|catch|continue|elif|else|enum|fn|for|if|impl|in|match|matches|mut|not|or|pass|print|pub|return|struct|try|use|while|len|push|pop|sorted|range|input|int|float|typeof|istype|timestamp)\\b)(?:[a-z_][\\w]*)\\b"
        }
      ]
    },
    "function-call": {
      "patterns": [
        {
          "name": "entity.name.function.call.orus",
          "match": "(?<!\\.)(?<!::)\\b([A-Za-z_][\\w]*)\\b(?=\\s*\\()",
          "captures": {
            "1": { "name": "entity.name.function.call.orus" }
          }
        },
        {
          "name": "entity.name.function.call.orus",
          "match": "\\.(?:\\s*)([A-Za-z_][\\w]*)(?=\\s*\\()",
          "captures": {
            "1": { "name": "entity.name.function.call.orus" }
          }
        }
      ]
    },
    "operators": {
      "patterns": [
        {
          "name": "keyword.operator.orus",
          "match": "\\.\\.=|\\.\\.|::|->|\+=|-=|\\*=|/=|%=|:=|==|!=|<=|>=|<|>|=|\\+|\\-|\\*|\\/|%|\\?|~"
        }
      ]
    }
  }
}
