{
  "name": "orus-language-support",
  "displayName": "Orus",
  "description": "Language support for the Orus programming language: syntax highlighting, snippets, and tooling.",
  "version": "0.1.1",
  "publisher": "orus-lang",
  "license": "MIT",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Programming Languages"
  ],
  "keywords": [
    "orus",
    "language",
    "syntax",
    "highlighting"
  ],
  "icon": "logo/logo.png",
  "activationEvents": [
    "onLanguage:orus",
    "onCommand:orus.runFile",
    "onCommand:orus.createFileFromTemplate"
  ],
  "main": "./out/extension.js",
  "browser": "./out/extension-web.js",
  "extensionKind": [
    "workspace",
    "ui"
  ],
  "contributes": {
    "languages": [
      {
        "id": "orus",
        "aliases": [
          "Orus",
          "orus"
        ],
        "extensions": [
          ".orus"
        ],
        "filenamePatterns": [
          "*.orus"
        ],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "orus",
        "scopeName": "source.orus",
        "path": "./syntaxes/orus.tmLanguage.json"
      }
    ],
    "snippets": [
      {
        "language": "orus",
        "path": "./snippets/orus.code-snippets"
      }
    ],
    "themes": [
      {
        "label": "Orus One Dark",
        "uiTheme": "vs-dark",
        "path": "./themes/orus-color-theme.json"
      }
    ],
    "commands": [
      {
        "command": "orus.runFile",
        "title": "Orus: Run Current File",
        "category": "Orus"
      },
      {
        "command": "orus.createFileFromTemplate",
        "title": "Orus: New Sample File",
        "category": "Orus"
      }
    ],
    "menus": {
      "editor/title": [
        {
          "command": "orus.runFile",
          "group": "navigation",
          "when": "resourceExtname == .orus"
        }
      ]
    },
    "configurationDefaults": {
      "files.associations": {
        "*.orus": "orus"
      },
      "editor.tokenColorCustomizations": {
        "textMateRules": [
          {
            "scope": [
              "keyword.declaration.function.orus",
              "keyword.declaration.type.orus",
              "keyword.declaration.impl.orus",
              "keyword.control.conditional.orus",
              "keyword.control.loop.orus",
              "keyword.control.flow.orus",
              "keyword.control.exception.orus",
              "keyword.control.import.orus",
              "keyword.operator.logical.orus",
              "keyword.operator.membership.orus",
              "storage.modifier.orus"
            ],
            "settings": {
              "foreground": "#C678DD",
              "fontStyle": "italic"
            }
          },
          {
            "scope": [
              "support.function.builtin.orus",
              "entity.name.function.orus",
              "entity.name.function.call.orus"
            ],
            "settings": {
              "foreground": "#61AFEF"
            }
          },
          {
            "scope": [
              "entity.name.type.struct.orus",
              "entity.name.type.enum.orus",
              "entity.name.type.class.orus"
            ],
            "settings": {
              "foreground": "#E5C07B"
            }
          },
          {
            "scope": [
              "string.quoted.double.orus"
            ],
            "settings": {
              "foreground": "#98C379"
            }
          },
          {
            "scope": [
              "constant.numeric.orus"
            ],
            "settings": {
              "foreground": "#D19A66"
            }
          },
          {
            "scope": [
              "variable.other.constant.orus"
            ],
            "settings": {
              "foreground": "#B0B6C2"
            }
          },
          {
            "scope": [
              "variable.other.orus"
            ],
            "settings": {
              "foreground": "#C86B3C"
            }
          },
          {
            "scope": [
              "support.type.numeric.orus",
              "support.type.text.orus",
              "constant.language.boolean.orus"
            ],
            "settings": {
              "foreground": "#56B6C2"
            }
          },
          {
            "scope": [
              "comment.line.double-slash.orus",
              "comment.block.orus"
            ],
            "settings": {
              "foreground": "#5C6370",
              "fontStyle": "italic"
            }
          }
        ]
      }
    },
    "configuration": {
      "title": "Orus",
      "properties": {
        "orus.executablePath": {
          "type": "string",
          "default": "orus",
          "description": "Path to the Orus CLI executable used when running files."
        },
        "orus.runInTerminal": {
          "type": "boolean",
          "default": false,
          "description": "If enabled, run Orus files in an integrated terminal instead of the Orus output channel."
        }
      }
    },
    "iconThemes": [
      {
        "id": "orus-icons",
        "label": "Orus File Icons (Seti base)",
        "path": "./themes/orus-icon-theme.json"
      }
    ]
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "package": "vsce package"
  },
  "devDependencies": {
    "@types/node": "^20.11.10",
    "@types/vscode": "^1.85.0",
    "tslib": "^2.6.2",
    "typescript": "^5.4.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/jordyorel/orus_vscode_extention.git"
  }
}
