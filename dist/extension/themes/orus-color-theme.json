{
  "$schema": "vscode://schemas/color-theme",
  "name": "Orus One Dark",
  "type": "dark",
  "colors": {
    "editor.background": "#282C34",
    "editor.foreground": "#ABB2BF",
    "editor.lineHighlightBackground": "#2C313C",
    "editorLineNumber.foreground": "#5C6370",
    "editorCursor.foreground": "#528BFF",
    "editor.selectionBackground": "#3E4451",
    "sideBar.background": "#21252B",
    "sideBar.foreground": "#D7DAE0"
  },
  "tokenColors": [
    {
      "scope": [
        "keyword.declaration.function.orus",
        "keyword.declaration.type.orus",
        "keyword.declaration.impl.orus",
        "keyword.control.conditional.orus",
        "keyword.control.loop.orus",
        "keyword.control.flow.orus",
        "keyword.control.exception.orus",
        "keyword.control.import.orus",
        "keyword.operator.logical.orus",
        "keyword.operator.membership.orus",
        "storage.modifier.orus"
      ],
      "settings": {
        "foreground": "#C678DD"
      }
    },
    {
      "scope": [
        "support.function.builtin.orus"
      ],
      "settings": {
        "foreground": "#61AFEF"
      }
    },
    {
      "scope": [
        "entity.name.function.orus",
        "entity.name.function.call.orus"
      ],
      "settings": {
        "foreground": "#61AFEF"
      }
    },
    {
      "scope": [
        "entity.name.type.struct.orus",
        "entity.name.type.enum.orus",
        "entity.name.type.class.orus"
      ],
      "settings": {
        "foreground": "#E5C07B"
      }
    },
    {
      "scope": [
        "string.quoted.double.orus"
      ],
      "settings": {
        "foreground": "#98C379"
      }
    },
    {
      "scope": [
        "constant.numeric.orus"
      ],
      "settings": {
        "foreground": "#D19A66"
      }
    },
    {
      "scope": [
        "constant.language.boolean.orus",
        "support.type.numeric.orus",
        "support.type.text.orus"
      ],
      "settings": {
        "foreground": "#56B6C2"
      }
    },
    {
      "scope": [
        "constant.other.constant.orus"
      ],
      "settings": {
        "foreground": "#E5C07B"
      }
    },
    {
      "scope": [
        "variable.other.orus"
      ],
      "settings": {
        "foreground": "#E06C75"
      }
    },
    {
      "scope": [
        "comment.line.double-slash.orus",
        "comment.block.orus"
      ],
      "settings": {
        "foreground": "#5C6370",
        "fontStyle": "italic"
      }
    }
  ]
}
