{
  "$schema": "vscode://schemas/color-theme",
  "name": "Orus Purple",
  "type": "dark",
  "colors": {
    "editor.background": "#0F101A",
    "editor.foreground": "#E6E6F0",
    "editor.lineHighlightBackground": "#1B1D2E",
    "editorLineNumber.foreground": "#4D4F77",
    "editorCursor.foreground": "#C3A6FF",
    "editor.selectionBackground": "#3C2E5E60",
    "sideBar.background": "#121324",
    "sideBar.foreground": "#BFC1D9"
  },
  "tokenColors": [
    {
      "scope": [
        "keyword.declaration.function.orus",
        "keyword.declaration.type.orus",
        "keyword.declaration.impl.orus",
        "keyword.control.conditional.orus",
        "keyword.control.loop.orus",
        "keyword.control.flow.orus",
        "keyword.control.exception.orus",
        "keyword.control.import.orus",
        "keyword.operator.logical.orus",
        "keyword.operator.membership.orus",
        "storage.modifier.orus"
      ],
      "settings": {
        "foreground": "#A988FF"
      }
    },
    {
      "scope": [
        "support.function.builtin.orus"
      ],
      "settings": {
        "foreground": "#C7A3FF"
      }
    },
    {
      "scope": [
        "entity.name.function.orus",
        "entity.name.function.call.orus"
      ],
      "settings": {
        "foreground": "#7DD3FC"
      }
    },
    {
      "scope": [
        "entity.name.type.struct.orus",
        "entity.name.type.enum.orus",
        "entity.name.type.class.orus"
      ],
      "settings": {
        "foreground": "#FF99D6"
      }
    },
    {
      "scope": [
        "string.quoted.double.orus"
      ],
      "settings": {
        "foreground": "#9BE29B"
      }
    },
    {
      "scope": [
        "constant.numeric.orus"
      ],
      "settings": {
        "foreground": "#F8D068"
      }
    },
    {
      "scope": [
        "constant.language.boolean.orus"
      ],
      "settings": {
        "foreground": "#F49AC2"
      }
    },
    {
      "scope": [
        "constant.other.constant.orus"
      ],
      "settings": {
        "foreground": "#FFD479"
      }
    },
    {
      "scope": [
        "comment.line.double-slash.orus",
        "comment.block.orus"
      ],
      "settings": {
        "foreground": "#646892",
        "fontStyle": "italic"
      }
    }
  ]
}
